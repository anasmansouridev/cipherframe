# Cloudflare Pages headers. The build fills in the sha256 of the inlined boot script
# and adds origins for any video, image or event endpoint set in src/config.ts.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' __EARLY_HASH__ https://app.cal.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://app.cal.com; img-src 'self' data: https://app.cal.com https://cal.com __EXTRA_IMG__; font-src 'self'; connect-src 'self' https://app.cal.com https://cal.com https://api.cal.com https://cloudflareinsights.com __EXTRA_CONNECT__; frame-src https://app.cal.com https://cal.com https://tally.so; media-src 'self' __EXTRA_MEDIA__; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://tally.so; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/work/*
  Cache-Control: public, max-age=86400

/index.html
  Cache-Control: public, max-age=0, must-revalidate
